# Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Server-only Supabase Edge Function secrets (never use VITE_ prefix):
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# APP_URL=https://your-production-domain.example
# ADDITIONAL_ALLOWED_ORIGINS=https://staging.example.com,https://app.example.com




# Security email alerts (server-side Supabase Edge Function secrets; never VITE_):
# RESEND_API_KEY=re_...
# SECURITY_ALERT_FROM_EMAIL=security@your-verified-domain.example

# ---- Client build variables (public) ----
# Public https URL of the deployed WEB app. REQUIRED for the Android APK (e-mail verification / password-reset links open this URL).
# VITE_APP_URL=https://your-production-domain.example

# Edge Functions must accept the Android WebView origin:
# ADDITIONAL_ALLOWED_ORIGINS=https://localhost,https://staging.example.com
